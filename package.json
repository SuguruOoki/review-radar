{
  "name": "review-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-grounded human code-review triage with Jev / TypeSafe",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "review-radar": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:dist": "node --test tests/*.test.mjs",
    "demo": "node dist/cli.js demo --out demo-output",
    "doctor": "node dist/cli.js doctor"
  },
  "devDependencies": { "@types/node": "22.15.30", "typescript": "5.8.3" },
  "license": "MIT"
}
